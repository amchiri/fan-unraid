<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "fan-control">
  <!ENTITY author    "amchiri">
  <!ENTITY version   "2025.05.23">
  <!ENTITY launch    "Settings/FanControl">
  <!ENTITY gitURL    "https://raw.githubusercontent.com/amchiri/fan-unraid/main">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&gitURL;/plugin/fan-control.plg" launch="&launch;" icon="tachometer" min="6.9.0">

<CHANGES>
###2025.05.23
- Contrôle automatique des fans Corsair Commander Pro
- Courbes de température configurables (Silencieux / Équilibré / Performance)
- Mode manuel avec PWM fixe
- Dashboard temps réel : RPM + températures CPU/NVMe
- Page WebUI intégrée dans le GUI Unraid (Settings → Utilities)
- Daemon en arrière-plan, intervalle configurable
- Config persistante sur la clé USB
</CHANGES>

<!-- Daemon script -->
<FILE Name="/usr/local/sbin/fan-control-daemon" Mode="0755">
<URL>&gitURL;/source/fan-control-daemon</URL>
</FILE>

<!-- WebUI page -->
<FILE Name="/usr/local/emhttp/plugins/fan-control/FanControl.page" Mode="0644">
<URL>&gitURL;/source/FanControl.page</URL>
</FILE>

<!-- Default config (only written if not already present) -->
<FILE Name="/tmp/fan-control-config.default" Mode="0644">
<URL>&gitURL;/source/config.default</URL>
</FILE>

<!-- Post-install script -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
mkdir -p /boot/config/plugins/fan-control
mkdir -p /tmp/fan-control

# Install default config only if not already configured
if [ ! -f /boot/config/plugins/fan-control/config ]; then
    cp /tmp/fan-control-config.default /boot/config/plugins/fan-control/config
    echo "Default config installed"
fi
rm -f /tmp/fan-control-config.default

# Restart daemon
pkill -f fan-control-daemon 2>/dev/null
sleep 1
nohup /usr/local/sbin/fan-control-daemon >> /tmp/fan-control/daemon.log 2>&1 &
echo "Fan Control started (PID: $!)"
]]>
</INLINE>
</FILE>

<!-- Uninstall script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
pkill -f fan-control-daemon 2>/dev/null
rm -f /usr/local/sbin/fan-control-daemon
rm -rf /usr/local/emhttp/plugins/fan-control
rm -rf /tmp/fan-control
echo "Fan Control removed"
]]>
</INLINE>
</FILE>

</PLUGIN>

  </div>
  <div class="cf-card">
    <div class="label">PWM Cible</div>
    <div class="value" style="color:<?= pct_color(pwm_to_pct($status['target_pwm'])) ?>">
      <?= pwm_to_pct($status['target_pwm']) ?>%
    </div>

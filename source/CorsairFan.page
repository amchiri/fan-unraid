<script>
function toggleFanManual(num) {
    var cb  = document.getElementById('fan' + num + '_manual');
    var ctrl = document.getElementById('fan' + num + '_ctrl');
    var hidden = document.getElementById('fan' + num + '_pwm_val');
    if (cb.checked) {
        ctrl.style.display = '';
        var range = document.getElementById('fan' + num + '_pwm_range');
        hidden.value = range.value;
    } else {
        ctrl.style.display = 'none';
        hidden.value = 'auto';
    }
}

function updateFanPwm(num, val) {
    val = parseInt(val);
    document.getElementById('fan' + num + '_pwm_val').value = val;
    document.getElementById('fan' + num + '_pwm_lbl').textContent =
        Math.round(val * 100 / 255) + '% (' + val + ')';
}

<?php if ($daemon_running): ?>
setTimeout(function(){ location.reload(); }, 30000);
<?php endif; ?>
</script>

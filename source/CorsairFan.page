<?PHP
$config_file = "/boot/config/plugins/corsair-fan/config";
$status_file = "/tmp/corsair-fan/status.json";
$daemon_pid  = "/tmp/corsair-fan/daemon.pid";

// Lire la config
$cfg = ['PROFILE'=>'balanced','MANUAL_PWM'=>102,'CHECK_INTERVAL'=>30,
        'CURVE_SILENT'=>'30:51 40:64 50:89 60:115 70:153 80:204',
        'CURVE_BALANCED'=>'30:77 40:102 50:128 60:160 70:204 80:240',
        'CURVE_PERFORMANCE'=>'30:102 40:140 50:179 60:210 70:240 80:255',
        'FAN1_PWM'=>'auto','FAN2_PWM'=>'auto','FAN3_PWM'=>'auto',
        'FAN4_PWM'=>'auto','FAN5_PWM'=>'auto','FAN6_PWM'=>'auto'];
if (file_exists($config_file)) {
    foreach (file($config_file) as $line) {
        $line = trim($line);
        if (!$line || $line[0]==='#') continue;
        if (preg_match('/^(\w+)=(.*)$/', $line, $m))
            $cfg[$m[1]] = trim($m[2], '"\'');
    }
}

// Vérifier si le daemon tourne
$daemon_running = false;
if (file_exists($daemon_pid)) {
    $pid = trim(file_get_contents($daemon_pid));
    $daemon_running = $pid && file_exists("/proc/$pid");
}

// Lire le statut JSON
$status = null;
if (file_exists($status_file)) $status = json_decode(file_get_contents($status_file), true);

// Actions POST
if ($_POST) {
    if (isset($_POST['profile'])) {
        $profile = in_array($_POST['profile'], ['silent','balanced','performance','manual'])
            ? $_POST['profile'] : 'balanced';
        $manual_pwm = max(0, min(255, (int)($_POST['manual_pwm'] ?? 102)));
        $interval   = max(5, min(300, (int)($_POST['interval'] ?? 30)));

        $curves = [
            'CURVE_SILENT'      => trim($_POST['curve_silent'] ?? $cfg['CURVE_SILENT']),
            'CURVE_BALANCED'    => trim($_POST['curve_balanced'] ?? $cfg['CURVE_BALANCED']),
            'CURVE_PERFORMANCE' => trim($_POST['curve_performance'] ?? $cfg['CURVE_PERFORMANCE']),
        ];

        $fan_overrides = [];
        for ($i = 1; $i <= 6; $i++) {
            $val = $_POST["fan{$i}_pwm"] ?? 'auto';
            if ($val !== 'auto') $val = max(0, min(255, (int)$val));
            $fan_overrides["FAN{$i}_PWM"] = $val;
            $cfg["FAN{$i}_PWM"] = $val;
        }

        $content = "PROFILE=$profile\n\n";
        foreach ($curves as $k=>$v) $content .= "$k=\"$v\"\n";
        $content .= "\nMANUAL_PWM=$manual_pwm\nCHECK_INTERVAL=$interval\n\n";
        foreach ($fan_overrides as $k=>$v) $content .= "$k=$v\n";
        file_put_contents($config_file, $content);
        $cfg['PROFILE'] = $profile;
        $cfg['MANUAL_PWM'] = $manual_pwm;
        $cfg['CHECK_INTERVAL'] = $interval;
    }

    if (isset($_POST['daemon_action'])) {
        if ($_POST['daemon_action'] === 'start' && !$daemon_running) {
            shell_exec("nohup /usr/local/sbin/corsair-fan-daemon >> /tmp/corsair-fan/daemon.log 2>&1 &");
        } elseif ($_POST['daemon_action'] === 'stop' && $daemon_running) {
            $pid = trim(file_get_contents($daemon_pid));
            shell_exec("kill $pid 2>/dev/null");
            @unlink($daemon_pid);
            @unlink($status_file);
            $daemon_running = false;
        }
        sleep(1);
        header("Location: /Settings/CorsairFan"); exit;
    }
    // Recharger le statut
    if (file_exists($status_file)) $status = json_decode(file_get_contents($status_file), true);
}

// Helpers pour les courbes
function parse_curve($curve_str) {
    $points = [];
    foreach (explode(' ', trim($curve_str)) as $pt) {
        if (strpos($pt,':')!==false) {
            [$t,$p] = explode(':', $pt);
            $points[] = [(int)$t, (int)$p];
        }
    }
    return $points;
}

function pwm_to_pct($pwm) { return round($pwm * 100 / 255); }
function pct_color($pct) {
    if ($pct < 40) return '#4caf50';
    if ($pct < 70) return '#ff9800';
    return '#f44336';
}
function temp_color($t) {
    if ($t < 50) return '#4caf50';
    if ($t < 70) return '#ff9800';
    return '#f44336';
}
?>

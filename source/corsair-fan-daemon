#!/bin/bash
# Fan Control Daemon
# Controls Commander Pro fans based on CPU temp
# Also monitors ALL hwmon fans (motherboard, etc.)

CONFIG="/boot/config/plugins/corsair-fan/config"
STATUS="/tmp/corsair-fan/status.json"
PIDFILE="/tmp/corsair-fan/daemon.pid"

mkdir -p /tmp/corsair-fan
echo $$ > "$PIDFILE"

log() { echo "[$(date '+%H:%M:%S')] $*"; }

find_cpro() {
    find /sys/devices -path "*/0003:1B1C:0C10.*/hwmon/hwmon*" -maxdepth 12 -type d 2>/dev/null | head -1
}

get_cpu_temp() {
    local max=0
    for f in /sys/class/hwmon/hwmon*/temp*_input; do
        [ -f "$f" ] || continue
        local hwmon_dir=$(dirname "$f")
        local name=$(cat "$hwmon_dir/name" 2>/dev/null)
        [ "$name" = "coretemp" ] || continue
        local val=$(cat "$f" 2>/dev/null)
        [ -z "$val" ] && continue
        local t=$(( val / 1000 ))
        [ "$t" -gt "$max" ] && max=$t
    done
    echo $max
}

get_pwm_for_temp() {
    local temp=$1 curve="$2" prev_t=0 prev_p=0 first=1
    for point in $curve; do
        local t=${point%:*} p=${point#*:}
        if [ "$first" -eq 1 ]; then
            if [ "$temp" -le "$t" ]; then echo $p; return; fi
            first=0
        fi
        if [ "$temp" -le "$t" ]; then
            local range_t=$(( t - prev_t ))
            local range_p=$(( p - prev_p ))
            local delta_t=$(( temp - prev_t ))
            echo $(( prev_p + (range_p * delta_t / range_t) ))
            return
        fi
        prev_t=$t; prev_p=$p
    done
    echo $prev_p
}

apply_pwm() {
    local cpro="$1" default_pwm="$2"
    for i in 1 2 3 4 5 6; do
        local override_var="FAN${i}_PWM"
        local override="${!override_var}"
        local pwm=$default_pwm
        if [[ "$override" =~ ^[0-9]+$ ]] && [ "$override" -ge 0 ] && [ "$override" -le 255 ]; then
            pwm=$override
        fi
        echo "$pwm" > "$cpro/pwm${i}" 2>/dev/null
    done
}

# Collect fans from ALL hwmon sources
get_all_fans_json() {
    local fans_json=""
    local uid=0

    for hwmon in /sys/class/hwmon/hwmon*; do
        [ -d "$hwmon" ] || continue
        local source=$(cat "$hwmon/name" 2>/dev/null)
        [ -z "$source" ] && continue

        for fan_input in "$hwmon"/fan*_input; do
            [ -f "$fan_input" ] || continue
            uid=$(( uid + 1 ))
            local fan_num=$(basename "$fan_input" | sed 's/fan\([0-9]*\)_input/\1/')
            local rpm=$(cat "$fan_input" 2>/dev/null); rpm=${rpm:-0}
            local pwm_file="$hwmon/pwm${fan_num}"
            local pwm=0
            local controllable="false"
            if [ -f "$pwm_file" ]; then
                pwm=$(cat "$pwm_file" 2>/dev/null); pwm=${pwm:-0}
                controllable="true"
            fi
            local pct=$(( pwm * 100 / 255 ))
            local label=$(cat "$hwmon/fan${fan_num}_label" 2>/dev/null | tr -d '"')
            [ -z "$label" ] && label="Fan ${fan_num}"

            [ -n "$fans_json" ] && fans_json="$fans_json,"
            fans_json="${fans_json}{\"uid\":${uid},\"source\":\"${source}\",\"num\":${fan_num},\"label\":\"${label}\",\"rpm\":${rpm},\"pwm\":${pwm},\"pct\":${pct},\"controllable\":${controllable}}"
        done
    done

    echo "$fans_json"
}

write_status() {
    local cpro="$1" profile="$2" cpu_temp="$3" pwm="$4"
    local ts=$(date '+%Y-%m-%d %H:%M:%S')

    local nvme_temp=0
    local nvme_f=$(cat /sys/class/hwmon/hwmon0/temp1_input 2>/dev/null)
    [ -n "$nvme_f" ] && nvme_temp=$(( nvme_f / 1000 ))

    local fans_json
    fans_json=$(get_all_fans_json)

    echo "{\"profile\":\"$profile\",\"cpu_temp\":$cpu_temp,\"nvme_temp\":$nvme_temp,\"target_pwm\":$pwm,\"fans\":[$fans_json],\"last_update\":\"$ts\",\"daemon_running\":true}" > "$STATUS"
}

log "Fan Control started (PID: $$)"

while true; do
    [ -f "$CONFIG" ] && source "$CONFIG"

    CPRO=$(find_cpro)
    if [ -z "$CPRO" ]; then
        log "Commander Pro not found, retrying..."
        sleep 10
        continue
    fi

    CPU_TEMP=$(get_cpu_temp)

    case "$PROFILE" in
        silent)      TARGET_PWM=$(get_pwm_for_temp "$CPU_TEMP" "$CURVE_SILENT") ;;
        performance) TARGET_PWM=$(get_pwm_for_temp "$CPU_TEMP" "$CURVE_PERFORMANCE") ;;
        manual)      TARGET_PWM=$MANUAL_PWM ;;
        *)           TARGET_PWM=$(get_pwm_for_temp "$CPU_TEMP" "$CURVE_BALANCED") ;;
    esac

    apply_pwm "$CPRO" "$TARGET_PWM"
    write_status "$CPRO" "$PROFILE" "$CPU_TEMP" "$TARGET_PWM"

    log "Profile=$PROFILE | CPU=${CPU_TEMP}°C | PWM=$TARGET_PWM ($(( TARGET_PWM * 100 / 255 ))%)"
    sleep "${CHECK_INTERVAL:-30}"
done
